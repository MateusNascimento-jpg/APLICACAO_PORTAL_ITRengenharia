# Portal ITR — exemplo de configuração. Nunca coloque credenciais reais neste arquivo.

NODE_ENV=development
PORT=3000
PUBLIC_APP_ORIGIN=http://localhost:3000

# Airtable
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TIMEOUT_MS=12000
AIRTABLE_RETRIES=3
AIRTABLE_CACHE_TTL_MS=300000

# MySQL
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT_MS=10000
DB_SSL=false

# Segurança — gere valores reais no .env com: node scripts/ensure-security-env.js
PORTAL_SECURITY_PEPPER=
SESSION_COOKIE_NAME=itr_portal_session
SESSION_HOURS=12
SESSION_REMEMBER_DAYS=7
DIRECTOR_SESSION_HOURS=12
TRUST_PROXY_HOPS=0
AUDIT_RETENTION_DAYS=180

# Localhost começa bloqueando mutações operacionais no Airtable.
PORTAL_SAFE_MODE=true
PORTAL_WRITE_ENABLED=false

# Rate limiting
LOGIN_MAX_TENTATIVAS_IP=40
LOGIN_MAX_TENTATIVAS_CONTA=10
DIRETOR_MAX_TENTATIVAS=8

# Autenticação de clientes 3.1 — rollout seguro.
# Mantenha false até o serviço Emails_diarios_ITRengenharia 2.1 estar configurado e testado.
CLIENT_PASSWORDS_ENABLED=false
CLIENT_PASSWORD_MIN_LENGTH=12
CLIENT_PASSWORD_MAX_LENGTH=128
CLIENT_ACTIVATION_TOKEN_MINUTES=30
CLIENT_RESET_TOKEN_MINUTES=20
CLIENT_ONBOARDING_VERSION=1
PASSWORD_REQUEST_IP_LIMIT=20
PASSWORD_REQUEST_ACCOUNT_LIMIT=5
PASSWORD_CONFIRM_IP_LIMIT=15

# Campos do cadastro de Clientes no Airtable usados na autenticação/avisos.
AIRTABLE_CLIENT_EMAIL_FIELD=Email Cliente
AIRTABLE_CLIENT_WHATSAPP_FIELD=WhatsApp do Cliente

# Serviço interno de notificações. Gere UM segredo e configure o mesmo valor no
# outro serviço como PORTAL_INTERNAL_HMAC_SECRET.
PORTAL_NOTIFICATIONS_URL=
PORTAL_NOTIFICATIONS_HMAC_SECRET=
PORTAL_NOTIFICATIONS_TIMEOUT_MS=10000
