# Portal ITR — exemplo de configuração. Nunca coloque credenciais reais neste arquivo.

NODE_ENV=development
PORT=3000
PUBLIC_APP_ORIGIN=http://localhost:3000

# Airtable
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
# Mesmo valor do serviço de e-mails; usado também no diagnóstico de confluência.
AIRTABLE_CLIENTES_TABLE_ID=tblkQxQ6q7cBKXZ3C
AIRTABLE_TIMEOUT_MS=12000
AIRTABLE_RETRIES=3
AIRTABLE_CACHE_TTL_MS=300000

# Airtable Financeiro — base separada do laboratório.
# AIRTABLE_FINANCE_TOKEN é opcional; quando vazio, reutiliza AIRTABLE_TOKEN.
AIRTABLE_FINANCE_BASE_ID=
AIRTABLE_FINANCE_TOKEN=
AIRTABLE_FINANCE_TIMEOUT_MS=12000
AIRTABLE_FINANCE_RETRIES=3

# Resolver code-only de escopo empresarial (nao exige campos novos no Airtable)
PORTAL_SCOPE_CACHE_TTL_MS=300000
PORTAL_SCOPE_STALE_MAX_MS=900000
PORTAL_SCOPE_PAGE_PACE_MS=220
PORTAL_SCOPE_OWNER_MIN_WORKS=3
PORTAL_SCOPE_SAMPLE_MIN_SHARED=5
# Escape hatch opcional, somente se um caso real for ambiguo e revisado:
# PORTAL_SCOPE_OVERRIDES_JSON=[["recAAAAAAAAAAAAAA","recBBBBBBBBBBBBBB"]]
PORTAL_SCOPE_OVERRIDES_JSON=

# MySQL
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT_MS=10000
DB_SSL=false

# Segurança — gere valores reais no .env com: node scripts/ensure-security-env.js
PORTAL_SECURITY_PEPPER=
SESSION_COOKIE_NAME=
SESSION_HOURS=12
SESSION_REMEMBER_DAYS=7
DIRECTOR_SESSION_HOURS=12
TRUST_PROXY_HOPS=0
AUDIT_RETENTION_DAYS=180

# Localhost começa bloqueando mutações operacionais no Airtable.
PORTAL_SAFE_MODE=true
PORTAL_WRITE_ENABLED=false

# Rate limiting
LOGIN_MAX_TENTATIVAS_IP=40
LOGIN_MAX_TENTATIVAS_CONTA=10
DIRETOR_MAX_TENTATIVAS=8
API_BURST_PER_MINUTE=600
LOGIN_BURST_PER_MINUTE=30
SCRYPT_MAX_CONCURRENCY=4
SCRYPT_QUEUE_LIMIT=24
READINESS_CACHE_MS=5000

# Parâmetros legados: CLIENT_PASSWORDS_ENABLED não muda o acesso gerado em 3.3.
# Limites PASSWORD_REQUEST continuam ativos para recuperação.
CLIENT_PASSWORDS_ENABLED=false
CLIENT_PASSWORD_MIN_LENGTH=12
CLIENT_PASSWORD_MAX_LENGTH=128
CLIENT_ACTIVATION_TOKEN_MINUTES=30
CLIENT_RESET_TOKEN_MINUTES=20
CLIENT_ONBOARDING_VERSION=1
PASSWORD_REQUEST_IP_LIMIT=20
PASSWORD_REQUEST_ACCOUNT_LIMIT=5
PASSWORD_CONFIRM_IP_LIMIT=15

# Campos do cadastro de Clientes no Airtable usados na autenticação/avisos.
AIRTABLE_CLIENT_EMAIL_FIELD=Email Cliente
AIRTABLE_CLIENT_WHATSAPP_FIELD=WhatsApp do Cliente

# Serviço interno de notificações. Gere UM segredo e configure o mesmo valor no
# outro serviço como PORTAL_INTERNAL_HMAC_SECRET.
PORTAL_NOTIFICATIONS_URL=
PORTAL_NOTIFICATIONS_HMAC_SECRET=
PORTAL_NOTIFICATIONS_TIMEOUT_MS=60000

# Visualização DEV opcional — não use credenciais reais neste arquivo.
# Acesse /dev-login.html, informe estas credenciais e o CNPJ que deseja visualizar.
DEV_VIEWER_ENABLED=false
DEV_VIEWER_USERNAME=
DEV_VIEWER_PASSWORD=

# Acesso por sigla + 6 primeiros dígitos do CNPJ
CLIENT_AUTH_MODE=generated
AIRTABLE_CLIENT_SIGLA_FIELD=Sigla Cliente

# Novo evento opcional de NF, sempre desativado até homologação e baseline validado.
PORTAL_NF_NOTIFICACOES_ATIVAS=false
