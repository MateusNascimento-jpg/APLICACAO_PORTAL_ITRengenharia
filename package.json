{
  "name": "portal-itr-engenharia",
  "version": "3.3.2",
  "description": "Portal do Cliente ITR Engenharia — escopo empresarial seguro, visualização DEV simples e design original preservado.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "bootstrap:director": "node scripts/bootstrap-director.js",
    "preflight": "node scripts/preflight.js",
    "verify": "node scripts/verify.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run verify && npm test",
    "reset:director-password": "node scripts/reset-director-password.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify:manifest": "node scripts/verify-release-manifest.js",
    "verify:release": "node scripts/verify.js --release",
    "unlock:director": "node scripts/unlock-director.js",
    "generate:notification-secret": "node scripts/generate-notification-secret.js",
    "test:security": "node --test tests/security-*.test.js tests/client-scope.test.js tests/abuse-guard.test.js",
    "test:load": "node scripts/security-load-test.js",
    "scope:diagnose": "node scripts/diagnose-client-scope.js",
    "diagnose:notifications": "node scripts/diagnose-notifications.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MateusNascimento-jpg/APLICACAO_PORTAL_ITRengenharia.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/MateusNascimento-jpg/APLICACAO_PORTAL_ITRengenharia/issues"
  },
  "homepage": "https://github.com/MateusNascimento-jpg/APLICACAO_PORTAL_ITRengenharia#readme",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.22.5"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
